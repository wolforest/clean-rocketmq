#!/bin/sh

if [ -z "$WOLFMQ_HOME" ] ; then
  PRG="$0"

  while [ -h "$PRG" ] ; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
      PRG="$link"
    else
      PRG="`dirname "$PRG"`/$link"
    fi
  done

  saveddir=`pwd`

  WOLFMQ_HOME=`dirname "$PRG"`/..

  WOLFMQ_HOME=`cd "$WOLFMQ_HOME" && pwd`

  cd "$saveddir"
fi

export WOLFMQ_HOME

other_args=" "
config_path=""

while [ $# -gt 0 ]; do
  case $1 in
    -p|--configPath)
      config_path="$2"
      shift
      shift
      ;;
    *)
      other_args=${other_args}" "${1}
      shift
      ;;
  esac
done

if [ -z "$config_path" ] ; then
  config_path="$WOLFMQ_HOME/conf"
fi

# make it fully qualified
case "$config_path" in
  /*) ;;
  *) config_path="$(pwd)/$config_path" ;;
esac

sh ${WOLFMQ_HOME}/bin/runserver.sh com.wolfmq.registry.Registry ${other_args} -p "${config_path}"
