#!/bin/sh

# Start the broker:
#   sh mqbroker [-p <config directory>] [options]
# The config directory holds broker.yml and store.yml, default: $WOLFMQ_HOME/conf

if [ -z "$WOLFMQ_HOME" ] ; then
  PRG="$0"

  # need this for relative symlinks
  while [ -h "$PRG" ] ; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
      PRG="$link"
    else
      PRG="`dirname "$PRG"`/$link"
    fi
  done

  saveddir=`pwd`

  WOLFMQ_HOME=`dirname "$PRG"`/..

  # make it fully qualified
  WOLFMQ_HOME=`cd "$WOLFMQ_HOME" && pwd`

  cd "$saveddir"
fi

export WOLFMQ_HOME

. "${WOLFMQ_HOME}/bin/env.sh"

other_args=" "
config_path=""

while [ $# -gt 0 ]; do
  case $1 in
    -p|--configPath)
      [ $# -ge 2 ] || error_exit "option $1 needs a config directory"
      config_path="$2"
      shift
      ;;
    *)
      other_args=${other_args}" "${1}
      ;;
  esac
  shift
done

[ -z "$config_path" ] && config_path="${WOLFMQ_HOME}/conf"

# make it fully qualified
case "$config_path" in
  /*) ;;
  *) config_path="`pwd`/${config_path}" ;;
esac

[ -d "$config_path" ] || error_exit "config directory does not exist: ${config_path}"

# the log file of the process is $WOLFMQ_LOG_DIR/broker.log
export WOLFMQ_LOG_NAME=broker

# exec: the JVM replaces this shell, so it is the process that mqshutdown finds
exec sh "${WOLFMQ_HOME}/bin/runbroker.sh" com.wolfmq.broker.Broker ${other_args} -p "${config_path}"
