#!/bin/sh

# Stop a wolfmq process:
#   sh mqshutdown {broker|registry}
# SIGTERM is sent first and the process gets WOLFMQ_SHUTDOWN_TIMEOUT seconds
# (default 30) to shut down gracefully, then it is killed.

GRACE_SECONDS="${WOLFMQ_SHUTDOWN_TIMEOUT:-30}"

# true if the process exists and has not exited yet
is_running()
{
    kill -0 "$1" 2>/dev/null || return 1

    # an exited process is still visible until its parent reaps it
    state=`ps -o stat= -p "$1" 2>/dev/null`
    case "$state" in
        Z*) return 1 ;;
    esac

    return 0
}

case $1 in
    broker)
        main_class='com\.wolfmq\.broker\.Broker'
        ;;
    registry)
        main_class='com\.wolfmq\.registry\.Registry'
        ;;
    *)
        echo "Usage: sh mqshutdown {broker|registry}"
        exit 1
        ;;
esac

# match the main class exactly, so that e.g. BrokerBootstrap is not taken for Broker
pid=`ps ax | grep java | grep -E " ${main_class}( |$)" | grep -v grep | awk '{print $1}'`

if [ -z "$pid" ] ; then
    echo "No mq$1 running."
    exit 1
fi

echo "The mq$1(${pid}) is running..."
kill ${pid} || exit 1
echo "Send shutdown request to mq$1(${pid}) OK"

# wait for the graceful shutdown
alive=1
i=0
while [ $i -lt $GRACE_SECONDS ]; do
    alive=""
    for p in ${pid}; do
        is_running "$p" && alive=1
    done

    [ -z "$alive" ] && break

    sleep 1
    i=$((i + 1))
done

if [ -n "$alive" ]; then
    echo "mq$1(${pid}) did not stop within ${GRACE_SECONDS}s, force kill it."
    kill -9 ${pid}
fi

echo "mq$1(${pid}) stopped."
