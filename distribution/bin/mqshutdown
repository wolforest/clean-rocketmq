#!/bin/sh

GRACE_SECONDS=30

case $1 in
    broker)
        pid=`ps ax | grep -i 'com.wolfmq.broker.Broker' | grep java | grep -v grep | awk '{print $1}'`
        ;;
    registry)
        pid=`ps ax | grep -i 'com.wolfmq.registry.Registry' | grep java | grep -v grep | awk '{print $1}'`
        ;;
    *)
        echo "Usage: sh mqshutdown {broker|registry}"
        exit 1
        ;;
esac

if [ -z "$pid" ] ; then
    echo "No mq$1 running."
    exit 1
fi

echo "The mq$1(${pid}) is running..."
kill ${pid}
echo "Send shutdown request to mq$1(${pid}) OK"

# wait for a graceful shutdown, force kill if it is still alive
i=0
while [ $i -lt $GRACE_SECONDS ]; do
    if ! kill -0 ${pid} 2>/dev/null ; then
        echo "mq$1(${pid}) stopped."
        exit 0
    fi
    sleep 1
    i=$((i + 1))
done

echo "mq$1(${pid}) did not stop within ${GRACE_SECONDS}s, force kill it."
kill -9 ${pid}
echo "mq$1(${pid}) is killed."
