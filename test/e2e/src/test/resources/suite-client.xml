<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="MQClientSuite">
    <groups>
        <run>
            <include name="client" />
        </run>
    </groups>

    <test verbose="1" preserve-order="true" name="ClientTest">
        <classes>
            <class name="com.wolfmq.test.e2e.pubsub.PubSubTest" />
            <class name="com.wolfmq.test.e2e.pubsub.OrderlyTest" />
            <class name="com.wolfmq.test.e2e.schedule.DelayTest" />
            <class name="com.wolfmq.test.e2e.transaction.TransactionSuccessTest" />
            <class name="com.wolfmq.test.e2e.transaction.TransactionFailureTest" />
            <class name="com.wolfmq.test.e2e.transaction.CheckFailureTest" />
            <class name="com.wolfmq.test.e2e.transaction.CheckSuccessTest" />
        </classes>
    </test>
</suite>
